<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MMT Finance Quiz</title>
    <style>
        * {margin: 0; padding: 0; box-sizing: border-box;}
        body {font-family: 'Segoe UI', sans-serif; background: linear-gradient(135deg, #2b5876 0%, #4e4376 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px;}
        .container {background: rgba(255, 255, 255, 0.95); border-radius: 20px; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1); width: 100%; max-width: 800px; padding: 40px;}
        .header {text-align: center; margin-bottom: 30px;}
        .logo {background: linear-gradient(45deg, #2b5876, #4e4376); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-size: 2.5rem; font-weight: bold; margin-bottom: 10px;}
        .subtitle {color: #666; font-size: 1.1rem;}
        .quiz-section {display: none;}
        .quiz-section.active {display: block;}
        .question-counter {text-align: center; margin-bottom: 20px; color: #666;}
        .progress-bar {height: 6px; background: #e0e0e0; border-radius: 3px; margin-bottom: 30px; overflow: hidden;}
        .progress-fill {height: 100%; background: linear-gradient(45deg, #2b5876, #4e4376); width: 0%; transition: width 0.3s ease;}
        .question {background: #f8f9fa; padding: 20px; border-radius: 15px; margin-bottom: 20px; border-left: 5px solid #2b5876;}
        .question h3 {color: #333; margin-bottom: 15px;}
        .options {display: grid; gap: 12px;}
        .option {background: white; border: 2px solid #e0e0e0; border-radius: 12px; padding: 12px; cursor: pointer; transition: 0.3s;}
        .option:hover {border-color: #2b5876;}
        .option.correct {border-color: #4CAF50; background: #e8f5e9;}
        .option.incorrect {border-color: #f44336; background: #ffebee;}
        .feedback {margin: 15px 0; padding: 10px; border-radius: 10px; text-align: center; font-weight: bold; display: none;}
        .feedback.correct {color: #4CAF50; border: 2px solid #4CAF50; background: #e8f5e9;}
        .feedback.incorrect {color: #f44336; border: 2px solid #f44336; background: #ffebee;}
        .btn {background: linear-gradient(45deg, #2b5876, #4e4376); color: white; border: none; padding: 12px 25px; border-radius: 50px; cursor: pointer; font-weight: bold; margin: 10px;}
        .btn:disabled {opacity: 0.5; cursor: not-allowed;}
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <div class="logo">MMT Finance Quiz</div>
        <div class="subtitle">Test Your Knowledge about Momentum (MMT)</div>
    </div>

    <!-- Start Screen -->
    <div id="start-screen" class="quiz-section active">
        <h2>Welcome!</h2>
        <p>Test your knowledge about the MMT Finance project. Let's see how much you know!</p>
        <button class="btn" onclick="startQuiz()">Start Quiz</button>
    </div>

    <!-- Quiz Screen -->
    <div id="quiz-screen" class="quiz-section">
        <div class="question-counter">
            <span id="current-question">1</span> of <span id="total-questions">10</span>
        </div>
        <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
        <div class="question"><h3 id="question-text"></h3><div class="options" id="options-container"></div></div>
        <div class="feedback" id="feedback"></div>
        <button class="btn" id="next-btn" onclick="nextQuestion()" disabled>Next</button>
    </div>

    <!-- Results Screen -->
    <div id="results-screen" class="quiz-section">
        <h2>Quiz Complete!</h2>
        <p>Your Score: <strong id="final-score"></strong> / <span id="total-count"></span></p>
        <button class="btn" onclick="restartQuiz()">Restart</button>
    </div>
</div>

<script>
const quizData = [
    {question: "What does MMT stand for in Momentum?", options: ["Momentum Money Token", "Momentum Market Trade", "Momentum Meta Token", "Momentum Multi Trade"], correct: 0},
    {question: "What is the primary goal of Momentum (MMT) Finance?", options: ["To provide a DeFi launchpad", "To replace Bitcoin", "To create a new NFT platform", "To launch a new meme coin"], correct: 0},
    {question: "Which type of ecosystem is Momentum focused on?", options: ["NFT Gaming", "DeFi & Web3", "Social Media", "Cloud Storage"], correct: 1},
    {question: "What is one unique feature of MMT Finance?", options: ["Multi-chain launchpad", "Centralized banking system", "Physical currency notes", "Traditional stock trading"], correct: 0},
    {question: "Which network does MMT Finance initially build on?", options: ["Ethereum", "Binance Smart Chain", "Polygon", "Solana"], correct: 1},
    {question: "What benefit does MMT Finance provide to projects?", options: ["Liquidity & fundraising", "Only marketing", "Free NFTs", "Free mining machines"], correct: 0},
    {question: "What does the MMT token primarily power?", options: ["Governance & utility", "Only meme sharing", "Physical payments", "Mining rewards"], correct: 0},
    {question: "What type of platform is BuidlPad for Momentum?", options: ["Centralized exchange", "Launchpad for projects", "Social media app", "Crypto wallet"], correct: 1},
    {question: "What advantage does MMT provide for early investors?", options: ["Discounted token access", "Free houses", "Physical gold", "Mobile recharge"], correct: 0},
    {question: "Which sector is MMT Finance aiming to innovate?", options: ["DeFi fundraising & project launch", "E-commerce", "Cloud hosting", "Traditional banks"], correct: 0}
];

let currentQuestion = 0, score = 0, selectedOption = -1;

function startQuiz(){document.getElementById('start-screen').classList.remove('active');document.getElementById('quiz-screen').classList.add('active');document.getElementById('total-questions').textContent = quizData.length;loadQuestion();}

function loadQuestion(){if(currentQuestion>=quizData.length){showResults();return;}const q=quizData[currentQuestion];document.getElementById('current-question').textContent=currentQuestion+1;document.getElementById('question-text').textContent=q.question;const oc=document.getElementById('options-container');oc.innerHTML='';q.options.forEach((opt,i)=>{const el=document.createElement('div');el.className='option';el.textContent=opt;el.onclick=()=>selectOption(i);oc.appendChild(el);});document.getElementById('progress-fill').style.width=((currentQuestion)/quizData.length*100)+'%';selectedOption=-1;document.getElementById('next-btn').disabled=true;document.getElementById('feedback').style.display='none';}

function selectOption(i){if(selectedOption!==-1)return;selectedOption=i;const opts=document.querySelectorAll('.option');const q=quizData[currentQuestion];opts.forEach((o,ind)=>{if(ind===q.correct){o.classList.add('correct');}else if(ind===selectedOption){o.classList.add('incorrect');}o.style.pointerEvents='none';});const fb=document.getElementById('feedback');if(selectedOption===q.correct){score++;fb.textContent='✅ Correct!';fb.className='feedback correct';}else{fb.textContent='❌ Incorrect. Correct: '+q.options[q.correct];fb.className='feedback incorrect';}fb.style.display='block';document.getElementById('next-btn').disabled=false;}

function nextQuestion(){currentQuestion++;setTimeout(loadQuestion,300);}

function showResults(){document.getElementById('quiz-screen').classList.remove('active');document.getElementById('results-screen').classList.add('active');document.getElementById('final-score').textContent=score;document.getElementById('total-count').textContent=quizData.length;}

function restartQuiz(){currentQuestion=0;score=0;selectedOption=-1;document.getElementById('results-screen').classList.remove('active');document.getElementById('start-screen').classList.add('active');}
</script>
</body>
</html>
